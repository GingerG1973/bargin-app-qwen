# Bargin environment configuration
# Copy this file to .env and fill in the values you need

# Push notifications (required for phone alerts)
# Get a topic at https://ntfy.sh — treat it like a password
BARGIN_NTFY_TOPIC=

# Anthropic API key for Claude capabilities
# Get at https://console.anthropic.com — use API key (sk-ant-api...), not OAuth
ANTHROPIC_API_KEY=

# eBay API credentials for search integration
# Get Production keys at https://developer.ebay.com
BARGIN_EBAY_CLIENT_ID=
BARGIN_EBAY_CLIENT_SECRET=

# Reddit API credentials for deal feeds
# Get at https://www.reddit.com/prefs/apps (type: script)
BARGIN_REDDIT_CLIENT_ID=
BARGIN_REDDIT_CLIENT_SECRET=
BARGIN_REDDIT_USER_AGENT=macos:bargin:0.9 (by /u/yourname)

# ZenRows API key for paid fetch tier (WAF bypass)
# Get at https://www.zenrows.com
BARGIN_ZENROWS_API_KEY=

# Daily budget cap for Claude ($USD). Set to 0 to disable cap.
BARGIN_LLM_DAILY_BUDGET_USD=1.00

# Daily max requests for ZenRows paid tier
BARGIN_ZENROWS_DAILY_MAX_REQUESTS=200
